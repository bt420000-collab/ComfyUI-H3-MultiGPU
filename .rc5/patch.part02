+@contextmanager
+def _prebuilt_fullthrottle_bridge(private_patcher):
+    """Feed a prebuilt MODEL into the historical Snapshot FullThrottle builder.
+
+    The builder normally loads its own checkpoint and optionally creates a Style
+    LoRA patch state.  For the public Core engine the workflow has already built
+    the final MODEL, so temporarily substitute that private patcher and expose its
+    existing ordinary weight patches as the replay state for prefix/tail islands.
+    No sampler, sigma, step count, LoRA choice, or prompt is changed here.
+    """
+    from . import loader as loader_mod
