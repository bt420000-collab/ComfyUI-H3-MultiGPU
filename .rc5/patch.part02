+
+    def load_private(_unet_name, _primary, _safe_profile):
+        return private_patcher, loader_mod._validate_h3(private_patcher)
+
+    def expose_prebuilt_patches(patcher, _stack):
+        state = style_mod.snapshot_weight_patch_state(patcher)
+        return patcher, state, ()
+
+    loader_mod._load_private_h3 = load_private
+    style_mod.apply_style_stack_to_private_patcher = expose_prebuilt_patches
+    try:
+        yield
+    finally:
+        loader_mod._load_private_h3 = original_load
+        style_mod.apply_style_stack_to_private_patcher = original_style_apply
+
