+class H3VMStyleLoRAStack:
+    """Appendable standard ModelPatcher LoRA stack, independent of GPU mode."""
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        import folder_paths
+        from .h3vm.style_lora import NONE_LORA
+        choices = [NONE_LORA] + list(folder_paths.get_filename_list("loras"))
+        required = {}
+        for i in range(1, 5):
+            required[f"lora_{i}"] = (choices, {"default": NONE_LORA})
+            required[f"strength_{i}"] = ("FLOAT", {"default": 1.0, "min": -4.0, "max": 4.0, "step": 0.05})
+        return {
+            "required": required,
+            "optional": {"previous_stack": ("H3VM_LORA_STACK",)},
+        }
+
+    RETURN_TYPES = ("H3VM_LORA_STACK", "STRING")
+    RETURN_NAMES = ("style_lora_stack", "summary")
+    FUNCTION = "build"
+    CATEGORY = "MiniMaxH3/H3VM"
+    DESCRIPTION = (
+        "普通风格/角色 LoRA 叠加器。每个节点可放 4 个，并可串接 previous_stack，"
+        "因此没有 4 个 LoRA 的架构限制。与 Turbo/加速 LoRA 分离，四种 GPU 模式共用同一套普通 LoRA。"
+    )
+
+    def build(self, lora_1, strength_1, lora_2, strength_2, lora_3, strength_3,
+              lora_4, strength_4, previous_stack=None):
+        from .h3vm.style_lora import append_style_loras, stack_summary
+        entries = [
+            (lora_1, strength_1), (lora_2, strength_2),
+            (lora_3, strength_3), (lora_4, strength_4),
+        ]
+        stack = append_style_loras(previous_stack, entries)
+        return (stack, stack_summary(stack))
+
+
+class H3VMCoreEngine:
+    """Pure MODEL -> H3VM execution -> MODEL adapter for external workflows."""
+
+    @classmethod
+    def INPUT_TYPES(cls):
+        from .h3vm.master_console import CAPACITY_VRAM_PROFILES, CORE_GPU_MODES
+        return {
+            "required": {
+                "model": ("MODEL",),
+                "gpu_mode": (CORE_GPU_MODES, {"default": "DUAL_QUIET｜双卡协同·执行引擎"}),
+                "capacity_vram_profile": (CAPACITY_VRAM_PROFILES, {
+                    "default": "SAFE｜保守·最稳",
+                    "tooltip": "仅 DUAL_CAPACITY 执行引擎使用；不修改主工作流生成参数。"
+                }),
+                "expected_steps_hint": ("INT", {
+                    "default": 4, "min": 1, "max": 100, "step": 1,
+                    "tooltip": "仅供 H3VM 预取/最后一步调度参考；不会修改主工作流实际 sampler steps。"
+                }),
+                "telemetry": ("BOOLEAN", {"default": True}),
+            }
+        }
+
+    RETURN_TYPES = ("MODEL", "H3VM_MODE")
+    RETURN_NAMES = ("model", "mode")
+    FUNCTION = "adapt"
+    CATEGORY = "MiniMaxH3/H3VM"
+    DESCRIPTION = (
+        "纯 H3VM 执行引擎。输入应是主工作流已经完成底模、Turbo、普通 LoRA、SigmaShift 等业务处理后的最终 MODEL。"
+        "本节点不修改 Prompt、Seed、分辨率、Sampler、Sigmas 或实际 Steps；只负责单卡/双卡执行与显存调度。"
+    )
+
+    def adapt(self, model, gpu_mode="DUAL_QUIET｜双卡协同·执行引擎",
+              capacity_vram_profile="SAFE｜保守·最稳", expected_steps_hint=4, telemetry=True):
+        from .h3vm.core_adapter import H3VMCoreConfig, adapt_model
+        from .h3vm.master_console import normalize_mode
+        mode = normalize_mode(gpu_mode)
+        config = H3VMCoreConfig(
+            mode=mode,
+            primary_device="gpu:0",
+            secondary_device="gpu:1",
+            capacity_vram_profile=str(capacity_vram_profile),
+            expected_steps=max(1, int(expected_steps_hint)),
+            telemetry=bool(telemetry),
+        )
+        out = adapt_model(model, config=config)
+        return (out, mode)
+
+
