+        # sampler contract in H3VMMasterLoader.  The executor itself is the
+        # Snapshot-Islands FullThrottle runtime (approximate stale/predicted
+        # boundary features), exactly as in the historical Dev9.4 A/B workflow.
+        from .loader import build_h3_snapshot_islands_full_throttle
+        print(
