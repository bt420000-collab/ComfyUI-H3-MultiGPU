+def _mode4_fullthrottle_host_policy() -> dict:
+    """Choose a safe Dev9.4 host feeder for the active ComfyUI pinning policy.
+
+    Historical Dev9.4 used ``--disable-pinned-memory`` plus an H3VM-owned,
+    bounded 1 GiB pinned mailbox.  Product Mode 4 must also work under normal
+    ComfyUI startup where global pinned memory is enabled.  In that case we do
+    not create a second explicit pinned pool: activation/snapshot traffic falls
+    back to ordinary pageable RAM while ComfyUI keeps ownership of its global
+    pinned-weight policy.
+    """
+    pinned_disabled = True
+    try:
+        from comfy.cli_args import args
+        pinned_disabled = bool(getattr(args, "disable_pinned_memory", False))
+    except Exception:
+        # Unit tests / non-Comfy import: retain the historical safe profile.
+        pinned_disabled = True
+
+    if pinned_disabled:
+        return {
+            "safe_profile": True,
+            "host_feeder": "bounded_pinned",
+            "pinned_mailbox_mb": 1024,
+            "policy": "h3vm_bounded_pinned",
+        }
+    return {
+        "safe_profile": False,
+        "host_feeder": "pageable",
+        "pinned_mailbox_mb": 0,
+        "policy": "comfy_global_pinned+pageable_h3vm",
+    }
+
+
 def build_asset_model(*, unet_name: str, turbo_lora_name: str, turbo_strength: float = 1.0,
-                      turbo_low_vram: bool = False, config: H3VMCoreConfig):
